# Keep secrets server-side. v1.8 can save them locally to config/secrets.env from Settings when running on localhost.
# Never put secrets into the standalone HTML or frontend JavaScript.
APIFY_TOKEN=
SIGNALYTH_DRY_RUN=true
SIGNALYTH_DATA_DIR=./data
SIGNALYTH_MAX_PARALLEL_RUNS=2

# OpenAI AI Analysis. Keep keys server-side; UI never receives them. Defaults verified against official OpenAI API docs on 2026-09-04; model IDs remain replaceable.
OPENAI_API_KEY=
SIGNALYTH_AI_ENABLED=false
SIGNALYTH_AI_BULK_MODEL=gpt-5.6-luna
SIGNALYTH_AI_REASONING_MODEL=gpt-5.6-terra
SIGNALYTH_AI_BATCH_SIZE=12
SIGNALYTH_AI_MAX_TEXT_CHARS=6000
SIGNALYTH_AI_MAX_OUTPUT_TOKENS=7000
SIGNALYTH_AI_MAX_COST_USD=3.0
# Editable price hints used only by SIGNALYTH's AI cost guard / estimate.
SIGNALYTH_AI_BULK_INPUT_USD_PER_MTOK=0.20
SIGNALYTH_AI_BULK_OUTPUT_USD_PER_MTOK=1.20
SIGNALYTH_AI_REASONING_INPUT_USD_PER_MTOK=2.00
SIGNALYTH_AI_REASONING_OUTPUT_USD_PER_MTOK=12.00

# Security: secret setup endpoints are localhost-only unless you deliberately deploy behind auth + TLS.
SIGNALYTH_ALLOW_REMOTE_SECRET_SETUP=false

# Vercel deployment (set in Vercel Project > Settings > Environment Variables).
# Vercel sets VERCEL automatically. Connect a PRIVATE Vercel Blob store so
# BLOB_READ_WRITE_TOKEN is injected. Do not commit the real value.
BLOB_READ_WRITE_TOKEN=
SIGNALYTH_CLOUD_STORAGE=false
SIGNALYTH_EXECUTION_BACKEND=thread
# On Vercel these defaults switch automatically to:
# SIGNALYTH_DATA_DIR=/tmp/signalyth-data
# SIGNALYTH_RUNTIME_CONFIG_DIR=/tmp/signalyth-config
# SIGNALYTH_CLOUD_STORAGE=true
# SIGNALYTH_EXECUTION_BACKEND=celery
